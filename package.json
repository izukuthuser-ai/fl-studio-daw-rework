{
  "name": "loopforge-studio",
  "productName": "LoopForge Studio",
  "version": "0.1.0",
  "description": "A pattern-based DAW with FL Studio-compatible shortcuts, rebuilt to be faster and friendlier.",
  "author": "izukuthuser",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.izukuthuser.loopforge",
    "productName": "LoopForge Studio",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "fileAssociations": [{ "ext": "lfproj", "name": "LoopForge Project", "role": "Editor" }],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "LoopForge-Studio-Setup-${version}.exe" },
    "portable": { "artifactName": "LoopForge-Studio-Portable-${version}.exe" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo", "icon": "build/icon.png", "artifactName": "LoopForge-Studio-${version}.AppImage" },
    "mac": { "target": ["dmg"], "category": "public.app-category.music", "icon": "build/icon.png" }
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
